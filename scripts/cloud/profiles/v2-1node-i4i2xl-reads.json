{
 "description": "Single i4i.2xlarge rerun of the v1 read/mixed steps (task 0572): one valsd node (4 SPDK partitions, RF 1, one PD) with a colocated client. Checks that netprogress multiread no longer reports per-key quorum_failed (0569) and records the value-read restart/busy counters and point-read rate. ~30 min, < $0.50.",
 "hours": 1.0,
 "hostmon_interval": 1.0,
 "colocate_clients": 1,
 "fleet": {
  "node": {
   "type": "i4i.2xlarge",
   "count": 1,
   "market": "on-demand",
   "root_gb": 60
  }
 },
 "cluster": {
  "backend": "spdk",
  "drives_per_node": 1,
  "parts_per_drive": 4,
  "rf": 1,
  "vals_profile": "capacity",
  "sweep": "5s",
  "gc_grace": "0s",
  "hugemem_mib": 8192,
  "default_zone_fraction": 0.6,
  "named_zone_fraction": 0.05
 },
 "steps": [
  {
   "name": "prep",
   "kind": "prep"
  },
  {
   "name": "cluster",
   "kind": "cluster"
  },
  {
   "name": "prefill",
   "kind": "netload",
   "workload": "netbatchwrite",
   "strict": true,
   "prefix": "pf",
   "n": 16000000,
   "vsize": 100,
   "coords": 4,
   "conc": 256,
   "env": {
    "VALS_NETBATCHWRITE_WIDTH": 32
   },
   "timeout": 1200
  },
  {
   "name": "r-strong-c4",
   "kind": "netload",
   "workload": "netread",
   "prefix": "pf",
   "n": 16000000,
   "vsize": 100,
   "coords": 4,
   "conc": 64,
   "secs": 45,
   "profile": true
  },
  {
   "name": "r-multi256",
   "kind": "netload",
   "workload": "netmultiread",
   "prefix": "pf",
   "n": 16000000,
   "vsize": 100,
   "coords": 4,
   "conc": 2,
   "secs": 45,
   "env": {
    "VALS_NETMULTIREAD_BATCH": 256
   }
  },
  {
   "name": "verify-prefill",
   "kind": "netload",
   "workload": "netmultiread",
   "strict": true,
   "prefix": "pf",
   "n": 16000000,
   "vsize": 100,
   "coords": 4,
   "conc": 2,
   "timeout": 1200,
   "env": {
    "VALS_NETMULTIREAD_BATCH": 256
   }
  },
  {
   "name": "m1-closed",
   "kind": "np",
   "secs": 180,
   "threads": 4,
   "slots": 32,
   "keys": 8192,
   "vsize": 256,
   "read_pct": 65,
   "multi_pct": 10,
   "rate": 0,
   "profile": true,
   "profile_at": 60
  },
  {
   "name": "m2-open50",
   "kind": "np",
   "secs": 120,
   "threads": 4,
   "slots": 32,
   "keys": 8192,
   "vsize": 256,
   "read_pct": 65,
   "multi_pct": 10,
   "rate_from": "m1-closed",
   "rate_frac": 0.5
  },
  {
   "name": "stop",
   "kind": "stop"
  }
 ]
}
